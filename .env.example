# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zoho SMTP (이메일 발송)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Site
NEXT_PUBLIC_SITE_URL=

# Cron (예약 발행 스케줄러 인증) — Vercel Cron이 Authorization: Bearer <값>으로 호출
CRON_SECRET=

# 카카오 공유 (선택) — Kakao Developers JavaScript 키. 설정 시 기사에 '카카오톡' 공유 버튼 노출.
# Kakao Developers 콘솔에서 플랫폼 도메인(https://www.kjtimes.co.kr)도 등록 필요.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Setup scripts (run locally only, never in production CI)
DATABASE_URL=
ADMIN_PASSWORD=
